offset_top = 71.0
offset_right = 420.0
offset_bottom = 343.0
grow_horizontal = 2
theme_override_colors/default_color = Color(0.75686276, 0.75686276, 0.75686276, 1)
text = "Você é Lídia, uma estudante da Fatec Campinas.  Infelizmente, seu celular descarregou e você não viu o aviso de que hoje, dia 30, não haveria aula e foi para a faculdade, que estava vazia.

Pouco depois de chegar, sons estranhos de trovões, uivos e gritos tomaram o ar, como se viessem do cemitério. O céu ficou completamente nublado.
Na hora era impossível saber, mas no cemitério próximo à Fatec alguém havia iniciado um ritual que deu muito errado. Agora monstros, mortos-vivos e espíritos assombram a região.

Você precisa sobreviver com o que tiver à disposição até que o ritual falho seja cancelado.

Boa sorte.
"

